FROM ghcr.io/astral-sh/uv:0.12.19 AS uv
FROM python:3.14.7-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends git ripgrep ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --create-home repair
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --extra dev --no-install-project --python /usr/local/bin/python3.14
COPY . .
RUN uv sync --locked --extra dev --python /usr/local/bin/python3.14 \
    && mkdir -p /data /app/.langgraph_api \
    && chown -R repair:repair /app /data

ENV PATH=/app/.venv/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONUNBUFFERED=1 UV_PYTHON_DOWNLOADS=never
USER repair
EXPOSE 2024
ENTRYPOINT ["/bin/sh", "/app/deploy/repair/start-backend.sh"]
